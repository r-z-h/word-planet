# 复制为 .env 后按需修改。不要提交真实 .env。

DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/word_planet
JWT_SECRET=请替换为 64 位随机字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

APP_TIMEZONE=Asia/Shanghai
ENABLE_SCHEDULER=0

# 用 `vapid --gen` 生成，或留空（留空时每日提醒不会发送）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

CORS_ORIGINS=http://localhost:5173,https://localhost:5173
